# ==============================================================================
# VERDIX — Environment Configuration Template
# Architectural Notice: Raw dataset values must NEVER be placed in environment variables.
# ==============================================================================

# VERDIX CLOUD API
PORT=4000
NODE_ENV=development
API_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000

# VERDIX CLOUD WEB
NEXT_PUBLIC_API_URL=http://localhost:4000
PORT_WEB=3000

# VERDIX LOCAL AGENT
VERDIX_CLOUD_URL=http://localhost:4000
VERDIX_AGENT_ID=agent-local-dev-01
VERDIX_AGENT_NAME="Local Dev Enclave"
VERDIX_ENVIRONMENT=development
# Path to local directory where agent can access authorized datasets
VERDIX_LOCAL_DATA_DIR=./agent/data
# Maximum records permitted in a single statistical sample (to prevent data exfiltration)
VERDIX_MAX_EXPORT_ROWS=0
